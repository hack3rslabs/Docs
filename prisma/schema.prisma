generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                    String   @id @default(cuid())
  companyName           String
  logoAlignment         String   @default("left")
  address               String?
  authorizedPerson      String?
  authorizedDesignation String?
  purpose               String?
  place                 String?
  phone                 String?
  email                 String?
  webAddress            String?
  companyLogo           String?
  stamp                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  subscriptionEnd       DateTime?
  subscriptionActive    Boolean  @default(true)

  admins                Admin[]
  leads                 Lead[]
  applications          Application[]
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
}

model Lead {
  id                   String        @id @default(cuid())
  name                 String
  email                String
  phone                String
  applicationToken     String?
  applicationSubmitted Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  lastCopiedLink       String?
  paymentAmount        Float?        @default(15000)
  paymentStatus        String?       @default("Pending") // Pending, Paid, Waived
  
  companyId            String?
  company              Company?      @relation(fields: [companyId], references: [id])
  
  applications         Application[]
}

model Application {
  id                 String   @id @default(cuid())
  leadId             String?
  lead               Lead?    @relation(fields: [leadId], references: [id])
  
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])

  name               String
  email              String
  phone              String
  fatherName         String?
  dob                String?
  gender             String?
  maritalStatus      String?
  address            String?
  aadhar             String?
  pan                String?
  panFile            String?
  aadharFile         String?
  resume             String?
  designation        String?
  department         String?
  joiningDate        String?
  relievingDate      String?
  ctc                String?
  companyName        String?
  jobType            String?
  mentorName         String?
  mentorDesignation  String?
  dateDocument       String?
  empId              String?
  approved           Boolean  @default(false)
  bankName           String?
  accountNumber      String?
  ifsc               String?
  branchName         String?
  bankPassbook       String?
  uan                String?
  esi                String?
  pfFile             String?
  offerDate          String?
  appointmentDate    String?
  experienceDate     String?
  internshipDate     String?
  nocDate            String?
  payslipDate        String?
  hikeDate           String?
  workingDays        Int?
  referenceFile      String?
  hikeAmount         String?
  hikeIssueDate      String?
  pfStatus           String?
  remarks            String?
  basic              Float?
  houseRentAllowance Float?
  statutoryBonus     Float?
  specialAllowance   Float?
  monthlyCtc         Float?
  employerEsi        Float?
  employerPf         Float?
  employeeEsi        Float?
  providentFund      Float?
  professionalTax    Float?
  tds                Float?
  grossSalary        Float?
  totalContribution  Float?
  totalDeduction     Float?
  netTakeHome        Float?
  annualCtc          Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  hikeLetters        HikeLetter[]
  auditLogs          AuditLog[]
}

model HikeLetter {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  hikeAmount     Float
  hikeDate       String      // Effective date
  hikeIssueDate  String      // Issue Date
  previousCtc    Float
  newCtc         Float
  percentage     Float?      // Percentage of hike
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model AuditLog {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  field          String
  oldValue       String?
  newValue       String?
  modifiedBy     String      // Email or ID of the admin who modified it
  
  createdAt      DateTime    @default(now())
}
